# ==============================================================================
# @moni/nl-browser & Demo Server Environment Configuration
# ==============================================================================

# 1. JEV UI Policy Decision Model (TypeSafe / SystemOne API)
# Used for UI interaction decisions (CLICK / TYPE_TEXT / SELECT / WAIT / DONE)
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# 2. LLM Text Generation Helper (OpenAI-compatible / DeepSeek / etc.)
# Used exclusively to infer input field string values when JEV selects TYPE_TEXT
TEXT_MODEL_API_KEY=your_text_model_api_key_here
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat
TEXT_MODEL_REASONING=disabled

# 3. Optional Chrome DevTools Protocol WebSocket URL
# If left commented, the driver automatically discovers Chrome via DevToolsActivePort
# CHROME_CDP_URL=ws://127.0.0.1:9222/devtools/browser/...
